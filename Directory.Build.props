<Project>
  <PropertyGroup>
    <!-- AutoCAD installation path.
         Override via:
           1. Local file: copy Directory.Build.props.user.example to
              Directory.Build.props.user and set your path
           2. Environment variable: set AutoCADPath=C:\path\to\AutoCAD
           3. Command line: dotnet build -p:AutoCADPath="C:\path\to\AutoCAD" -->
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADPath>

    <!-- BricsCAD installation path (BricsCAD host head, src/Bricscad).
         Same override routes as AutoCADPath. -->
    <BricsCADPath Condition="'$(BricsCADPath)' == ''">C:\Program Files\Bricsys\BricsCAD V26 en_US</BricsCADPath>

    <!-- Common project settings -->
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>

    <!-- The plugin's version, read from the one place it is written
         (.claude-plugin/plugin.json). The host heads stamp their DLL with it,
         so the file version and devreload.log name the build that runs. -->
    <DevReloadVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory).claude-plugin\plugin.json')), '(?&lt;="version"\s*:\s*")[0-9]+(\.[0-9]+){1,3}').Value)</DevReloadVersion>
  </PropertyGroup>

  <!-- Allow local override file (git-ignored) -->
  <Import Project="Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
</Project>
