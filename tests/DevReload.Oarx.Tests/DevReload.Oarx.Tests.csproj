<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ImportWindowsDesktopTargets>false</ImportWindowsDesktopTargets>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- AutoCAD-independent payload logic, link-included so no AutoCAD assembly
       enters the test build (repo convention, as in RevitDevReload.Tests). -->
  <ItemGroup>
    <Compile Include="..\..\src\Autocad\DevReload\Oarx\Payload\*.cs" LinkBase="Sut" />
    <Compile Include="..\..\src\Autocad\DevReload\Oarx\OarxBuildFolder.cs" LinkBase="Sut" />
    <Compile Include="..\..\src\Autocad\DevReload\ConsoleProcess.cs" LinkBase="Sut" />
  </ItemGroup>
</Project>
