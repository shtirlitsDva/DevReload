<UserControl x:Class="DevReload.Views.OarxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevReload.ViewModels"
             Style="{DynamicResource RootPanel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Relative path (NOT pack://...;component) — required for the
                     dictionary to resolve when the assembly is loaded by AutoCAD. -->
                <ResourceDictionary Source="../Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- ── Bottom toolbar ────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ToolbarBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentBtn}"
                        Content="+ Add OARX Group"
                        Command="{Binding ShowAddOarxCommand}"
                        Margin="0,0,8,0"/>
                <Button Style="{StaticResource SurfaceBtn}"
                        Content="Reload Config"
                        Command="{Binding ReloadConfigCommand}"
                        ToolTip="Re-read plugins.json and resync both registries"/>
            </StackPanel>
        </Border>

        <!-- ── Main content ──────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Empty state -->
                <StackPanel Style="{StaticResource OarxEmptyStatePanel}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="20">
                    <TextBlock Text="No OARX groups configured"
                               Style="{StaticResource EmptyTitle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="An OARX group is one or more native modules built under one solution, in load order."
                               Style="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               MaxWidth="260"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- OARX group list -->
                <ItemsControl ItemsSource="{Binding OarxPlugins}"
                              Visibility="{Binding HasOarxPlugins, Converter={StaticResource BoolToVis}}"
                              Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OarxPluginItemViewModel}">
                            <Border Style="{StaticResource PluginCard}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Name + status + worktree + remove -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource IconDangerBtn}"
                                                Content="X"
                                                Command="{Binding DataContext.RemoveOarxPluginCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Name}"
                                                ToolTip="Unload and remove this OARX group"/>

                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource RowSurfaceBtn}"
                                                Content="✎"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.ShowEditOarxCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Name}"
                                                ToolTip="Edit this group and its profiles — which worktree folders it builds from, and what it builds there"/>

                                        <!-- Profile picker: what (and from which worktree
                                             folder) the group builds and loads. -->
                                        <ComboBox DockPanel.Dock="Right"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemsSource="{Binding Profiles}"
                                                  SelectedItem="{Binding SelectedProfile}"
                                                  DropDownOpened="WorktreeComboBox_DropDownOpened"
                                                  Margin="8,0,4,0"
                                                  MinWidth="80"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Profile to build and load from (set up profiles with ✎)">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                    <Setter Property="ToolTip" Value="{Binding WorktreePath}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>

                                        <Ellipse DockPanel.Dock="Left"
                                                 Style="{StaticResource StatusDot}"
                                                 Width="10" Height="10"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource PluginName}"/>
                                            <TextBlock Style="{StaticResource Caption}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="["/><Run Text="{Binding CommandPrefix, Mode=OneWay}"/><Run Text="]"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource Caption}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="Transparent"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding CompanionsToolTip}"
                                                    Visibility="{Binding HasCompanions, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding CompanionsSummary}"
                                                           Style="{StaticResource Caption}"/>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Row 1: the modules, in load order -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Modules}"
                                               Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="18,0,0,6"
                                               ToolTip="Load order — unload runs in reverse"/>

                                    <!-- Row 2: Actions -->
                                    <DockPanel Grid.Row="2">
                                        <CheckBox DockPanel.Dock="Right"
                                                  Style="{StaticResource SmallCheckBox}"
                                                  Content="Auto-load"
                                                  IsChecked="{Binding LoadOnStartup}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"/>

                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="OarxConfigDrop"
                                                          Style="{StaticResource BuildConfigDropToggle}"
                                                          Content="{Binding SelectedConfiguration}"
                                                          IsChecked="{Binding IsConfigPickerOpen, Mode=TwoWay}"
                                                          Margin="0,0,4,0"
                                                          ToolTip="Build configuration (click to choose from the project's Configuration|x64 pairs)"/>
                                            <Popup PlacementTarget="{Binding ElementName=OarxConfigDrop}"
                                                   Placement="Bottom" StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   IsOpen="{Binding IsConfigPickerOpen, Mode=TwoWay}"
                                                   DataContext="{Binding PlacementTarget.DataContext,
                                                       RelativeSource={RelativeSource Self}}">
                                                <Border Style="{StaticResource FlyoutPanel}" Margin="0,2,0,0"
                                                        MinWidth="{Binding ActualWidth, ElementName=OarxConfigDrop}">
                                                    <ItemsControl ItemsSource="{Binding AvailableConfigurations}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource ConfigItemBtn}"
                                                                        Content="{Binding}"
                                                                        Command="{Binding DataContext.SelectConfigurationCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>

                                            <!-- Reload = unload → verify writable → build → load.
                                                 The flyout carries the two halves on their own:
                                                 load what is already built, or build without loading. -->
                                            <Border Style="{StaticResource SplitBar}" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource SplitMainBtn}"
                                                            Content="Reload"
                                                            Command="{Binding ReloadCommand}"
                                                            ToolTip="Unload, rebuild and load the whole group"/>
                                                    <ToggleButton x:Name="OarxReloadFlyout"
                                                                  Style="{StaticResource SplitArrowToggle}"
                                                                  Content="▾"
                                                                  IsChecked="{Binding IsBuildMenuOpen, Mode=TwoWay}"
                                                                  ToolTip="More build actions"/>
                                                    <Popup PlacementTarget="{Binding ElementName=OarxReloadFlyout}"
                                                           Placement="Bottom" StaysOpen="False"
                                                           AllowsTransparency="True"
                                                           IsOpen="{Binding IsBuildMenuOpen, Mode=TwoWay}">
                                                        <Border Style="{StaticResource FlyoutPanel}" Margin="0,2,0,0">
                                                            <StackPanel>
                                                                <Button Style="{StaticResource RowSurfaceBtn}"
                                                                        Content="Load (no build)"
                                                                        Command="{Binding LoadCommand}"
                                                                        ToolTip="Load the modules as they currently sit on disk"/>
                                                                <Button Style="{StaticResource RowSurfaceBtn}"
                                                                        Content="Build only"
                                                                        Command="{Binding BuildOnlyCommand}"
                                                                        ToolTip="Build without loading — only possible while the group is unloaded, because a mapped module locks its file"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </StackPanel>
                                            </Border>

                                            <Button Style="{StaticResource RowDangerBtn}"
                                                    Content="Unload"
                                                    Command="{Binding UnloadCommand}"
                                                    IsEnabled="{Binding IsLoaded}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
