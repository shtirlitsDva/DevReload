<Window x:Class="DevReload.Views.OarxGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DevReload.ViewModels"
        Title="{Binding Title}"
        Width="920" Height="660" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource RootWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Relative path (NOT pack://...;component) — required for the
                     dictionary to resolve when loaded by AutoCAD. -->
                <ResourceDictionary Source="../Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ▲ ▼ ✕ for any ordered row: every row knows its own list, so one
                 set of commands on the window serves them all. -->
            <DataTemplate x:Key="RowButtons">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RowSurfaceBtn}" Content="▲" Margin="0,0,4,0"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" ToolTip="Earlier"/>
                    <Button Style="{StaticResource RowSurfaceBtn}" Content="▼" Margin="0,0,4,0"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" ToolTip="Later"/>
                    <Button Style="{StaticResource IconDangerBtn}" Content="X"
                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" ToolTip="Remove"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="PathRow" DataType="{x:Type vm:OarxPathRow}">
                <DockPanel Margin="0,0,0,2">
                    <ContentControl DockPanel.Dock="Right" Content="{Binding}"
                                    ContentTemplate="{StaticResource RowButtons}"/>
                    <TextBlock Text="{Binding Display}" Style="{StaticResource PluginName}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}"/>
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- ── Group ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Style="{StaticResource FormPanel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Group name" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                         Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNewGroup}"
                         ToolTip="The group's identity. Fixed once created (rename = remove and add again)."/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="Command prefix" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                         Text="{Binding CommandPrefix, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{}{PREFIX}LOAD / DEV / UNLOAD. Defaults to the group name."/>

                <CheckBox Grid.Row="1" Grid.Column="2" Content="Load on startup"
                          VerticalAlignment="Center"
                          IsChecked="{Binding LoadOnStartup}"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Caption}" Margin="0,6,0,0">
                    <Run Text="Solution (in each profile's folder):"/> <Run Text="{Binding SolutionDisplay, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ── Status + Save / Discard / Close ───────────────── -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Discard" Style="{StaticResource DialogSurfaceBtn}"
                        Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                        ToolTip="Throw away unsaved edits"/>
                <Button Content="Save" Style="{StaticResource DialogAccentBtn}"
                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource DialogSurfaceBtn}"
                        Click="Close_Click"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Profiles ──────────────────────────────────── -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Profiles" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Style="{StaticResource SurfaceBtn}" Content="+ New profile"
                            Command="{Binding ShowNewProfileCommand}" Margin="0,0,0,4"
                            ToolTip="Build this group from another worktree folder"/>
                    <Button Style="{StaticResource SurfaceBtn}" Content="Remove missing"
                            Command="{Binding RemoveMissingCommand}"
                            ToolTip="Delete every profile whose worktree folder is gone (never the active one)"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                           Text="Unsaved changes — Save or Discard to switch profile."/>
                <Border Style="{StaticResource ListPanel}">
                    <ListBox ItemsSource="{Binding ProfileList}"
                             SelectedItem="{Binding SelectedListItem}"
                             IsEnabled="{Binding IsClean}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OarxProfileListItem}">
                                <DockPanel Margin="2,3" ToolTip="{Binding WorktreePath}">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Marker}" Width="16"
                                               Style="{StaticResource PluginName}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}"
                                               Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PluginName}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ── Right side ────────────────────────────────── -->
            <DockPanel Grid.Column="1">
                <!-- New profile: pick a folder, a name, what to copy -->
                <Border DockPanel.Dock="Top" Style="{StaticResource FormPanel}" Margin="0,0,0,10"
                        Visibility="{Binding IsCreatingProfile, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="New profile" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Worktree" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource RowSurfaceBtn}" Content="Browse…"
                                    Margin="6,0,0,0" Command="{Binding BrowseNewProfileFolderCommand}"
                                    ToolTip="Pick any folder"/>
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding Worktrees}"
                                      SelectedItem="{Binding SelectedWorktree}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </DockPanel>
                        <TextBox Text="{Binding NewProfileFolder, Mode=OneWay}" Style="{StaticResource ReadOnlyField}"
                                 IsReadOnly="True" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Profile name" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Copy from" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding CopyFromChoices}"
                                          SelectedItem="{Binding SelectedCopyFrom}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SurfaceBtn}" Content="Cancel"
                                    Command="{Binding CancelNewProfileCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource AccentBtn}" Content="Create"
                                    Command="{Binding CreateProfileCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Selected profile -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Draft}">
                    <StackPanel Margin="0,0,6,0">
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource RowSurfaceBtn}" Content="Make active" Margin="0,0,4,0"
                                        Command="{Binding DataContext.MakeActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Build and load the group from this profile (staged if the group is loaded)"/>
                                <Button Style="{StaticResource RowDangerBtn}" Content="Delete"
                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Delete this profile (not the active one). The folder is not touched."/>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Worktree folder" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <DockPanel Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource RowSurfaceBtn}" Content="Change…"
                                    Margin="6,0,0,0"
                                    Command="{Binding DataContext.ChangeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBox Text="{Binding WorktreePath, Mode=OneWay}" Style="{StaticResource ReadOnlyField}"
                                     IsReadOnly="True" ToolTip="{Binding WorktreePath}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Visibility="{Binding FolderMissing, Converter={StaticResource BoolToVis}}"
                                   Text="⚠ This folder does not exist (the worktree was removed?). The profile can't load."/>

                        <TextBlock Text="Modules — in LOAD order (.dbx before the .arx that uses it), relative to the folder"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,2"/>
                        <Border Style="{StaticResource ListPanel}" Margin="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding Modules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OarxModuleDraft}">
                                        <DockPanel Margin="0,0,0,2" ToolTip="{Binding FullPath}">
                                            <ContentControl DockPanel.Dock="Right" Content="{Binding}"
                                                            ContentTemplate="{StaticResource RowButtons}"/>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding ProjectName}"
                                                       Style="{StaticResource PluginName}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Rel" Text="{Binding RelativePath}" Style="{StaticResource Caption}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Exists}" Value="False">
                                                <Setter TargetName="Rel" Property="Text" Value="not found in this folder"/>
                                                <Setter TargetName="Rel" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Button Style="{StaticResource SurfaceBtn}" Content="+ Project" HorizontalAlignment="Left"
                                Margin="0,0,0,10"
                                Command="{Binding DataContext.AddModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Add .vcxproj module projects from this profile's folder"/>

                        <Expander Header="Advanced — MSBuild properties and companion DLLs" IsExpanded="False">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="MSBuild properties (Name=Value)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding Props}" ItemTemplate="{StaticResource PathRow}"/>
                                <DockPanel Margin="0,2,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SurfaceBtn}" Content="+ Property"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.AddPropCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBox Text="{Binding PropDraft, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="e.g. NdhFastDevLoop=true"/>
                                </DockPanel>

                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="A DLL picked from inside this profile's folder is stored relative, so a copied profile loads its own worktree's build of it."/>

                                <TextBlock Text="Preload — native DLLs (pinned by full path before the modules load)"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding PreloadNative}" ItemTemplate="{StaticResource PathRow}"/>
                                <Button Style="{StaticResource SurfaceBtn}" Content="+ DLL" HorizontalAlignment="Left" Margin="0,2,0,8"
                                        Command="{Binding DataContext.AddPreloadNativeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                <TextBlock Text="Preload — managed assemblies (loaded before the modules)"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding PreloadManaged}" ItemTemplate="{StaticResource PathRow}"/>
                                <Button Style="{StaticResource SurfaceBtn}" Content="+ Assembly" HorizontalAlignment="Left" Margin="0,2,0,8"
                                        Command="{Binding DataContext.AddPreloadManagedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                <TextBlock Text="Postload — managed assemblies (loaded after the modules)"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding PostloadManaged}" ItemTemplate="{StaticResource PathRow}"/>
                                <Button Style="{StaticResource SurfaceBtn}" Content="+ Assembly" HorizontalAlignment="Left" Margin="0,2,0,2"
                                        Command="{Binding DataContext.AddPostloadManagedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="⚠ An interop that pins a dbx makes the group refuse unload — that is by design, not an error."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
