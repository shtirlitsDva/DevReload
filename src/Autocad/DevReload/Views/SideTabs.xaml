<UserControl x:Class="DevReload.Views.SideTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource RootPanel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Relative path (NOT pack://...;component), as in the other views. -->
                <ResourceDictionary Source="../Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Style="{DynamicResource SideTab.Strip}">
            <StackPanel x:Name="Strip"/>
        </Border>
        <Grid x:Name="Pages" Grid.Column="1"/>
    </Grid>
</UserControl>
